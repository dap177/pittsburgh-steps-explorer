# Pittsburgh Steps Explorer - Local Development Environment
# Copy this file to .env and replace the values with your actual keys

# Google Maps API Key (required for map functionality)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Cloud Storage Settings (only needed if testing cloud storage locally)
GCS_BUCKET=pittsburgh-steps-uploads

# Other configuration
# Set to true to use Cloud Storage even in local development
# USE_CLOUD_STORAGE=false
